# Copy to .env.prod on the server and fill in. Never commit .env.prod.
#   cp .env.prod.example .env.prod

# ── Domain ────────────────────────────────────────────────────────────────
# Bare domain, no scheme. Caddy issues the TLS certificate for exactly this
# name, so its A/AAAA record must already point at the server.
APP_DOMAIN=atlas.example.com

# ── Laravel ───────────────────────────────────────────────────────────────
# Generate once, then keep it stable — rotating APP_KEY invalidates every
# existing session and any encrypted column:
#   echo "base64:$(openssl rand -base64 32)"
#
# Do not use `docker compose run ... artisan key:generate` for this: the api
# entrypoint waits for Postgres before running any command, so a one-off run
# with --no-deps hangs indefinitely.
APP_KEY=

# ── Database ──────────────────────────────────────────────────────────────
DB_DATABASE=atlas
DB_USERNAME=atlas
DB_PASSWORD=

# ── LiveKit Cloud ─────────────────────────────────────────────────────────
LIVEKIT_URL=wss://atlas-40nqcmte.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Hetzner Object Storage (S3-compatible) ────────────────────────────────
# Region is one of fsn1 / nbg1 / hel1 and must match the bucket's location.
S3_REGION=fsn1
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_BUCKET=atlas-videos
S3_RECORDINGS_BUCKET=atlas-recordings
S3_PUBLIC_URL=https://fsn1.your-objectstorage.com/atlas-videos
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Mail ──────────────────────────────────────────────────────────────────
# Mailpit is dev-only and is not part of the production stack; without real
# SMTP here, invitations and magic links are silently dropped.
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@atlas.example.com
MAIL_FROM_NAME=Atlas
